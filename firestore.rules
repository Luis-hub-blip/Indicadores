rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Helper: Validates member payload
    function isValidMember(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
             data.congregation is string && data.congregation.size() >= 3 && data.congregation.size() <= 60 &&
             data.designation is string && data.designation in ['Ancião', 'Servo Ministerial', 'Pioneiro Regular', 'Publicador Batizado'] &&
             data.primaryPhone is string && data.primaryPhone.size() == 9 && data.primaryPhone.matches('^[0-9]{9}$') &&
             data.hasPrimaryWhatsApp is bool &&
             (!('secondaryPhone' in data) || (data.secondaryPhone is string && (data.secondaryPhone.size() == 0 || (data.secondaryPhone.size() == 9 && data.secondaryPhone.matches('^[0-9]{9}$'))))) &&
             (!('hasSecondaryWhatsApp' in data) || data.hasSecondaryWhatsApp is bool) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
             data.isPresent is bool &&
             (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Helper: Validates admin account payload
    function isValidAdminAccount(data) {
      return data.adminName is string && data.adminName.size() >= 2 && data.adminName.size() <= 60 &&
             data.password is string && data.password.size() >= 4 && data.password.size() <= 100 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Members collection
    match /members/{memberId} {
      // Authenticated users can read members
      allow get, list: if isSignedIn();

      // Authenticated admins can create members
      allow create: if isSignedIn() &&
                       isValidId(memberId) &&
                       incoming().id == memberId &&
                       isValidMember(incoming());

      // Authenticated admins can update members (including presence toggle)
      allow update: if isSignedIn() &&
                       isValidId(memberId) &&
                       incoming().id == existing().id &&
                       incoming().createdAt == existing().createdAt &&
                       isValidMember(incoming());

      // Authenticated admins can delete members
      allow delete: if isSignedIn() && isValidId(memberId);
    }

    // Admin Accounts collection
    match /admin_accounts/{adminName} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() &&
                               isValidAdminAccount(incoming());
      allow delete: if false; // Admin accounts cannot be deleted directly
    }
  }
}
